# ==========================================
# NexoManager — Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
backend/.env
client/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production Build Outputs
dist/
client/dist/
build/
out/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Cache directories
.cache/
.vite/
client/.vite/
.eslintcache
.stylelintcache

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Database & Docker volumes
mongo_data/
*.sqlite
*.sqlite3
